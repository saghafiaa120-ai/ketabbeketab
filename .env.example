# نمونه‌ی متغیرهای محیطی — این فایل را به .env کپی کن و مقدارها را پر کن.
# برنامه با python app.py اجرا می‌شود و فایل .env را خودکار نمی‌خواند؛
# این متغیرها را در شل یا در پنل متغیرهای هاست تنظیم کن.
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_USER=ketabbeketab_user
DB_PASSWORD=replace-with-database-password
DB_NAME=ketabbeketab
COOKIE_SECURE=1
PORT=5000
FLASK_DEBUG=0
MAX_UPLOADS_PER_HOUR=20
