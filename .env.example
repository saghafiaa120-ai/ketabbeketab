# =========================================================
#  نمونه‌ی متغیرهای محیطی
#  این فایل را به .env کپی کن و مقدارها را پر کن.
#  فایل .env در .gitignore است و هیچ‌وقت commit نمی‌شود.
# =========================================================

# کلید نشست‌ها — یک رشته‌ی تصادفی طولانی بگذار:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# ---------- دیتابیس ----------
# در EthioDeploy افزونه‌ی Managed MySQL را از بخش Addons اضافه کن.
# EthioDeploy متغیر DATABASE_URL را به‌صورت خودکار تزریق می‌کند؛
# مقدار واقعی آن را اینجا ننویس و هرگز در GitHub قرار نده.
# DATABASE_URL=mysql://user:password@host:3306/database

# برای اجرای محلی با XAMPP از متغیرهای جداگانه استفاده کن:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ketabbeketab_user
DB_PASSWORD=replace-with-database-password
DB_NAME=ketabbeketab

# ---------- اجرا ----------
COOKIE_SECURE=1
PORT=5000
FLASK_DEBUG=0
MAX_UPLOADS_PER_HOUR=20

# ---------- کتاب‌های نمونه ----------
# در اولین اجرا (وقتی حساب demo وجود ندارد) ۱۰ کتاب نمونه در دیتابیس ثبت
# می‌شوند تا صفحه‌ی واقعی، قلب علاقه‌مندی و درخواست داشته باشند.
# برای خاموش‌کردن این رفتار مقدار 0 بگذار.
SEED_DEMO_BOOKS=1

# اگر می‌خواهی با حساب صاحب کتاب‌های نمونه وارد شوی (برای پاسخ به درخواست‌ها)،
# رمزش را اینجا بگذار. خالی بگذاری، رمز تصادفی می‌شود و ورود ممکن نیست.
# ایمیل این حساب: demo@ketab-beketab.local
DEMO_PASSWORD=

# ---------- پنل مدیریت ----------
# ایمیل حسابی که باید مدیر باشد. اگر این حساب وجود نداشته باشد، در اولین اجرا
# با ADMIN_PASSWORD ساخته می‌شود؛ اگر وجود داشته باشد فقط دسترسی مدیریت می‌گیرد.
# مقدارها را خودت بگذار — هیچ مقدار پیش‌فرضی در کد نیست.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سایت

# برای خاموش‌کردن ساخت/ارتقای خودکار حساب مدیر مقدار 0 بگذار.
ENSURE_ADMIN=1
